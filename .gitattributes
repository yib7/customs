# Normalize text to LF in the repository and in every checkout, so a clone on
# Windows does not rewrite line endings in diffs or in the shell scripts.
* text=auto eol=lf

*.png binary
*.gif binary
*.whl binary

# Trained model files: stored byte for byte, collapsed in diffs and language stats.
models/**/*.json -text -diff linguist-generated

# Lockfiles are generated by their package managers.
Cargo.lock linguist-generated
web/package-lock.json linguist-generated
python/uv.lock linguist-generated
