# Build output (web/dist is in web/.gitignore)
/target
*.egg-info/
# The Python binding when built in place (maturin develop)
*.so

# Dependencies and caches
**/node_modules
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# Server and script logs from local runs
*.log

# Data directory that `customs serve` creates in the working directory
/.customs/
# Training data (malware samples) if CUSTOMS_DATA is pointed inside the checkout
/customs-data/

# Secrets and local settings
.env
.env.*
# Vite settings for the mock API (no secrets)
!web/.env.mock
# Documented placeholders only
!deploy/.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Contributors' editor and OS files (the project itself configures no editor)
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Local agent and release-checklist files
.claude/
.autopilot/
