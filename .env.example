# Environment variables Customs reads. None is required: every one has a default, and
# each runtime variable mirrors a command-line flag (`customs serve --help` lists them).
# Copy to .env (gitignored) and uncomment what you need, then load it with
# `set -a; . ./.env; set +a` or `docker compose --env-file .env ...`.

# --- Server (customs serve) ---
# CUSTOMS_BIND=127.0.0.1:7878
# CUSTOMS_DATA_DIR=.customs
# CUSTOMS_MODELS=./models
# CUSTOMS_UI_DIR=./web/dist
# CUSTOMS_CACHE_MAX_MB=10240
# Secret. At least 16 characters; required for policy changes when set.
# CUSTOMS_ADMIN_TOKEN=change-me-to-a-long-random-string
# CUSTOMS_ADMIN_TOKEN_FILE=/run/secrets/customs_admin_token
# CUSTOMS_ALLOW_ANONYMOUS_POLICY_CHANGES=false
# Extra host names allowed to change the policy, comma-separated.
# CUSTOMS_ALLOWED_HOSTS=customs.internal
# Secret if your webhook URL embeds a token (Slack, Discord).
# CUSTOMS_NOTIFY_URL=https://hooks.example.com/your-webhook
# CUSTOMS_NOTIFY_FORMAT=auto
# CUSTOMS_NOTIFY_ON=block
# CUSTOMS_PUBLIC_URL=http://127.0.0.1:7878
# Extra CA bundle for a registry behind a TLS-inspecting proxy.
# CUSTOMS_CA_FILE=/etc/ssl/certs/corp-ca.pem
# Log filter (tracing EnvFilter syntax) and JSON log lines.
# CUSTOMS_LOG=info
# CUSTOMS_LOG_JSON=false

# --- Hooks and CLI (customs hook, customs check) ---
# CUSTOMS_SERVER=http://127.0.0.1:7878
# CUSTOMS_HOOK_FAIL_CLOSED=false

# --- Training pipeline (python/) ---
# Where datasets and malware samples are kept; outside the repository by default.
# CUSTOMS_DATA=/path/outside/the/repo/customs-data
# CUSTOMS_SCAN_BIN=./target/release/customs-scan
# GUARDDOG_BIN=guarddog

# --- Dashboard development (web/) ---
# CUSTOMS_BACKEND=http://127.0.0.1:7878
# CUSTOMS_CHROMIUM_PATH=/usr/bin/chromium
